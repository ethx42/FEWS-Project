# Fleet Early Warning System - Environment Variables Template
# Copy this file to .env and fill in your values

# Amazon SES Configuration
SENDER_EMAIL=alerts@yourdomain.com
ALERT_RECIPIENT=operations@yourdomain.com

# Optional: Multiple recipients (comma-separated)
# ALERT_RECIPIENT=ops1@yourdomain.com,ops2@yourdomain.com

# Logging Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# AWS Region (must match serverless.yml)
AWS_REGION=us-east-1
